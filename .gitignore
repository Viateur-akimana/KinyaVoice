# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/

# Virtual environments
venv/
env/
ENV/

# IDE files
.idea/
.vscode/
*.swp
*.swo

# Data directories (don't ignore the structure, but ignore the content)
/data/audio/*.mp3
/data/audio/*.wav
/data/transcriptions/*.txt
/data/responses/*.mp3
/data/responses/*.txt

# Keep the directories but not the temporary files
/data/audio_samples/*.mp3
/data/audio_samples/*.wav
/data/audio_samples/*.txt

# Allow QA pairs
!/data/qa_pairs/qa_pairs.json

# Exception for examples
!/data/audio/README.md
!/data/transcriptions/README.md
!/data/responses/README.md

# OS specific files
.DS_Store
Thumbs.db

# Model checkpoints
*.pt
*.pth
*.bin

# Logs
*.log
logs/

# Gradio cache
gradio_cached_examples/

.env
.venv/